{
  "name": "MyPriceBook Pay",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerEnv": {
    "POSTGRES_DB": "mypricebook_dev",
    "POSTGRES_USER": "mypricebook_dev",
    "POSTGRES_PASSWORD": "mypricebook_dev",
    "DATABASE_URL": "postgresql+psycopg://mypricebook_dev:mypricebook_dev@127.0.0.1:5432/mypricebook_dev"
  },
  "postStartCommand": "bash .devcontainer/start-postgres.sh",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Web app"
    },
    "8000": {
      "label": "FastAPI"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
