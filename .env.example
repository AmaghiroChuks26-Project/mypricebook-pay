# Safe local-development defaults only. Never put real credentials in this file.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Obtain a non-production managed PostgreSQL URL when the database phase begins.
DATABASE_URL=

# Public browser configuration; this value is not a secret.
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173

# Generate/provision securely per environment. Do not commit populated values.
AUTH_SECRET_KEY=
KORA_BASE_URL=
KORA_PUBLIC_KEY=
KORA_SECRET_KEY=
KORA_WEBHOOK_SECRET=
LOG_LEVEL=INFO
