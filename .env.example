# Development-only defaults. Never use these credentials outside local development.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=mypricebook_dev
POSTGRES_USER=mypricebook_dev
POSTGRES_PASSWORD=mypricebook_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mypricebook_dev:mypricebook_dev@127.0.0.1:5432/mypricebook_dev

# Leave unset to use the Vite development proxy. Set for a deployed API only.
# VITE_API_BASE_URL=
CORS_ORIGINS=http://localhost:5173

# Generate/provision securely per environment. Do not commit populated values.
AUTH_SECRET_KEY=
KORA_BASE_URL=
KORA_PUBLIC_KEY=
KORA_SECRET_KEY=
KORA_WEBHOOK_SECRET=
LOG_LEVEL=INFO
